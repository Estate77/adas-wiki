# ============================================
# 智驾 (ADAS-Wiki) - Vercel Postgres 配置
# ============================================

# 数据库 - Vercel Postgres 会自动设置以下环境变量：
# POSTGRES_URL      - 直接连接 URL
# POSTGRES_PRISMA_URL - Prisma 优化的连接 URL
DATABASE_URL="${POSTGRES_PRISMA_URL}"

# JWT 鉴权 - 请使用强随机字符串 (32+ 字符)
JWT_SECRET="generate-a-strong-random-secret-here-min-32-chars"

# 密码加密轮数
BCRYPT_ROUNDS=10

# AI 服务 (可选)
# AI_SERVICE_URL="https://your-ai-service.com"

# 跨域配置
CORS_ORIGIN="*"
